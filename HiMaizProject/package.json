{
    "name": "himaiz",
    "version": "0.1.0",
    "private": true,
    "description": "Personal site for Maiz, a static Next.js export served by Cloudflare Workers.",
    "packageManager": "npm@11.6.2",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "next dev --webpack",
        "build": "next build",
        "postbuild": "node scripts/flatten-segments.mjs && node scripts/strip-media.mjs",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "preview": "npm run build && wrangler dev",
        "deploy": "npm run build && wrangler deploy && wrangler deploy -c edge/www/wrangler.toml",
        "media:upload": "node scripts/media-upload.mjs",
        "media:check": "node scripts/media-check.mjs"
    },
    "dependencies": {
        "gray-matter": "^4.0.3",
        "lucide-react": "^1.42.0",
        "marked": "^18.2.1",
        "next": "^16.4.6",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.3.0",
        "@types/node": "^24.12.4",
        "@types/react": "^19.2.15",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.4",
        "eslint-config-next": "^16.4.6",
        "prettier": "^3.8.3",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vitest": "^5.1.1",
        "wrangler": "^4.166.0"
    },
    "overrides": {
        "postcss": "^8.5.15"
    }
}
