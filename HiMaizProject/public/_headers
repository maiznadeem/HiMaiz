# Cloudflare Workers static assets: response headers (https://developers.cloudflare.com/workers/static-assets/headers/).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# The work pages are being built in the open. Keep them out of search results until they are signed off,
# then delete this rule.
/work*
  X-Robots-Tag: noindex

# Hashed build files never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The generated images and the feed have no file extension or a generic one.
/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
/log/rss.xml
  Content-Type: application/rss+xml; charset=utf-8
